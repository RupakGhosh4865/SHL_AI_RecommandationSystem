# ===================================
# SHL Assessment Recommender - Environment Variables
# ===================================

# Google Gemini API Key (REQUIRED)
# Get FREE key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: HuggingFace API Key (for embeddings)
# Get FREE key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_hf_api_key_here

# API Configuration
API_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Data Paths (relative to project root)
DATA_PATH=data/processed/shl_catalog_clean.csv
EMBEDDINGS_PATH=data/embeddings/
LOGS_PATH=logs/

# API Settings
HOST=0.0.0.0
PORT=8000

# Frontend Settings
STREAMLIT_PORT=8501

# ===================================
# Docker Configuration
# ===================================
COMPOSE_PROJECT_NAME=shl-recommender

# ===================================
# Production Settings (Deployment)
# ===================================
# ALLOWED_ORIGINS=https://your-frontend.streamlit.app,https://your-api.onrender.com
# RATE_LIMIT_PER_MINUTE=100

# ===================================
# Instructions
# ===================================
# 1. Copy this file to .env
# 2. Replace "your_gemini_api_key_here" with your actual key
# 3. Never commit .env to git!
# 4. Add .env to .gitignore